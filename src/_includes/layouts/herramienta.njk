<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">

{% block jsonld %}{% endblock %}
{% if faq %}<script type="application/ld+json">
{{ faq | faqJsonLd | safe }}
</script>{% endif %}

<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
{% raw %}
  :root {
    --cream: #fdf6ee; --warm-white: #fffcf8; --blush: #f2c4b0;
    --terracota: #c97a5e; --deep: #3d2b1f; --mid: #7a5c4e; --soft: #c4a898;
    --sage: #7aaa8a; --sage-bg: #edf5f0;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--cream); font-family: 'DM Sans', sans-serif; color: var(--deep); min-height: 100vh; }

  .noise { position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: 0.025; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E"); }
  .blob { position: fixed; border-radius: 50%; filter: blur(80px); pointer-events: none; z-index: 0; }
  .blob-1 { width: 300px; height: 300px; background: #c4daf7; top: -100px; right: -80px; opacity: 0.35; }
  .blob-2 { width: 250px; height: 250px; background: #d4e8d8; bottom: -80px; left: -60px; opacity: 0.4; }

  .container { position: relative; z-index: 1; max-width: 440px; margin: 0 auto; padding: 40px 24px 60px; }

  .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--soft); text-decoration: none; margin-bottom: 32px; transition: color 0.2s; }
  .back-link:hover { color: var(--terracota); }

  header { text-align: center; margin-bottom: 36px; }
  .badge { display: inline-block; background: #ddeaf5; color: #4a7aaa; font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; padding: 5px 14px; border-radius: 20px; margin-bottom: 16px; }
  h1 { font-family: 'Fraunces', serif; font-weight: 300; font-size: 28px; line-height: 1.2; color: var(--deep); margin-bottom: 10px; }
  h1 em { font-style: italic; color: var(--terracota); }
  .subtitle { font-size: 14px; color: var(--mid); line-height: 1.5; font-weight: 300; text-align: justify; }

  .card { background: var(--warm-white); border-radius: 20px; padding: 24px 20px; margin-bottom: 16px; box-shadow: 0 2px 20px rgba(61,43,31,0.06); border: 1px solid rgba(196,168,152,0.2); }
  .section-label { font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--soft); margin-bottom: 16px; }

  .disclaimer { font-size: 11px; color: var(--soft); text-align: center; line-height: 1.6; margin-top: 24px; padding: 0 8px; }

  /* SEO content */
  .seo-section { margin-top: 40px; padding-top: 32px; border-top: 1px solid rgba(196,168,152,0.25); }
  .seo-section h2 { font-family: 'Fraunces', serif; font-weight: 400; font-size: 22px; color: var(--deep); margin-bottom: 12px; line-height: 1.3; }
  .seo-section h3 { font-family: 'Fraunces', serif; font-weight: 400; font-size: 17px; color: var(--deep); margin-bottom: 8px; margin-top: 24px; line-height: 1.3; }
  .seo-section p { font-size: 14px; color: var(--mid); line-height: 1.7; margin-bottom: 14px; font-weight: 300; text-align: justify; }
  .seo-section strong { color: var(--deep); font-weight: 500; }
  .faq-item { margin-bottom: 20px; }
  .faq-item h3 { margin-top: 0; }

  /* Fuentes */
  .sources { margin-top: 32px; padding-top: 24px; border-top: 1px solid rgba(196,168,152,0.25); }
  .sources-title { font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--soft); margin-bottom: 12px; }
  .sources ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .sources li { font-size: 13px; color: var(--mid); }
  .sources a { color: var(--mid); text-decoration: underline; text-decoration-color: rgba(196,168,152,0.5); transition: color 0.2s; }
  .sources a:hover { color: var(--terracota); }

  /* ── Desktop layout (común) ── */
  @media (min-width: 480px) { h1 { font-size: 34px; } }

  @media (min-width: 640px) {
    h1 { font-size: 38px; }
    .container { max-width: 860px; padding: 48px 40px 80px; }
    .blob-1 { width: 220px; height: 220px; opacity: 0.2; top: -60px; right: 40px; }
    .blob-2 { width: 180px; height: 180px; opacity: 0.25; bottom: -40px; left: 40px; }
  }
{% endraw %}
{% block css %}{% endblock %}
</style>

<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag("js",new Date());gtag("config","{{ site.gaId }}");</script>
</head>
<body>
<div class="noise"></div>
<div class="blob blob-1"></div>
<div class="blob blob-2"></div>

<div class="container">
  <a class="back-link" href="/">← Volver al inicio</a>
{% block contenido %}{% endblock %}
</div><!-- /container -->

{% block script %}{% endblock %}
</body>
</html>
