{% block script %}{% raw %}
<script>
const TYPES = [
  {
    emoji: '🌀',
    name: 'Fular elástico',
    tag: 'Tela elástica · requiere práctica al atarlo',
    detail: 'Una pieza larga de tela elástica que se enrolla alrededor del cuerpo del cuidador y del bebé. <strong>Se adapta al cuerpo del bebé y permite varias posiciones</strong>, pero hay que aprender a atarlo y a ajustar la tensión. Mira en las instrucciones del fabricante la edad y el peso para los que está pensado.',
    chips: [
      { label: 'Se ata con práctica', cls: 'chip-amber' },
      { label: 'Tela elástica', cls: 'chip-terracota' },
    ],
    tip: '<strong>Practica el atado antes de que llegue el bebé.</strong> Puedes probar con un peluche hasta que te salga sin mirar las instrucciones. Con el bebé y el cansancio, lo agradecerás.',
  },
  {
    emoji: '🪡',
    name: 'Fular tejido (rígido)',
    tag: 'Más versátil · para quien ya tiene práctica',
    detail: 'Parecido al elástico en la forma, pero de tejido que no se estira. <strong>Permite más posiciones y puede acompañar varias etapas</strong>, aunque requiere más habilidad para conseguir la tensión correcta. Comprueba en las instrucciones el rango de edad y de peso del modelo.',
    chips: [
      { label: 'Requiere más práctica', cls: 'chip-amber' },
      { label: 'Tejido que no se estira', cls: 'chip-terracota' },
    ],
    tip: '<strong>Si es tu primera vez, quizá no sea el mejor punto de partida.</strong> Puede tener más curva de aprendizaje que otros portabebés. Una asesora de porteo puede ayudarte a decidir.',
  },
  {
    emoji: '🎒',
    name: 'Mochila ergonómica con clip',
    tag: 'Práctica · fácil de poner y quitar',
    detail: 'Portabebés estructurado con clips y ajustes, sin necesidad de atar. <strong>Se pone y se quita con rapidez</strong>, por eso resulta práctico para el día a día. Conviene comprobar que permite la posición en M: no todas las mochilas del mercado lo permiten.',
    chips: [
      { label: 'Sin nudos', cls: 'chip-green' },
      { label: 'Comprueba que permita la posición en M', cls: 'chip-amber' },
    ],
    tip: '<strong>Comprueba que sea ergonómica antes de comprar.</strong> Fíjate en que la tela sujete de rodilla a rodilla, en que el culete quede más bajo que las rodillas y en que el panel sujete bien la espalda y la cabeza del bebé, según las instrucciones del fabricante.',
  },
  {
    emoji: '💫',
    name: 'Mei tai',
    tag: 'Intermedio entre fular y mochila',
    detail: 'Un portabebés de tela estructurada con cuatro tiras largas que se atan alrededor del cuerpo. <strong>Más sencillo que un fular, pero con más ajuste que una mochila de clips.</strong> Combina la adaptabilidad del fular con una parte estructurada. Comprueba en sus instrucciones para qué edad y peso está pensado.',
    chips: [
      { label: 'Se ata con tiras', cls: 'chip-terracota' },
      { label: 'Ajustable', cls: 'chip-green' },
    ],
    tip: '<strong>Una opción intermedia.</strong> Puede resultar más fácil de aprender que el fular tejido. Puede venir bien si varios adultos de distinta talla van a portear al mismo bebé.',
  },
  {
    emoji: '🌙',
    name: 'Anillo (ring sling)',
    tag: 'Rápido de poner · útil para trayectos cortos',
    detail: 'Una tira de tela que pasa por dos anillos. <strong>Es de los más rápidos de poner y quitar</strong> y puede resultar útil para trayectos cortos. Como la carga queda en un solo hombro, no siempre es la opción más cómoda para ratos largos. Mira en las instrucciones la edad y el peso para los que está pensado.',
    chips: [
      { label: 'Se pone rápido', cls: 'chip-green' },
      { label: 'Carga en un hombro', cls: 'chip-amber' },
    ],
    tip: '<strong>Valóralo según tu comodidad.</strong> Si notas molestias en el hombro o en la espalda, puede venirte bien reservarlo para trayectos cortos y usar otro portabebés como principal.',
  },
];

function buildTypes() {
  const list = document.getElementById('types-list');
  TYPES.forEach((t, i) => {
    const div = document.createElement('div');
    div.className = 'type-item';
    div.id = 'type-' + i;
    div.innerHTML = `
      <div class="type-header" onclick="toggleType(${i})" aria-label="Ver detalles de ${t.name}" role="button">
        <span class="type-emoji">${t.emoji}</span>
        <div class="type-info">
          <div class="type-name">${t.name}</div>
          <div class="type-tag">${t.tag}</div>
        </div>
        <span class="type-chevron">›</span>
      </div>
      <div class="type-body" role="region" aria-label="Detalles de ${t.name}">
        <p class="type-detail">${t.detail}</p>
        <div class="type-chips">
          ${t.chips.map(c => `<span class="type-chip ${c.cls}">${c.label}</span>`).join('')}
        </div>
        <div class="type-tip">💡 ${t.tip}</div>
      </div>`;
    list.appendChild(div);
  });
}

function toggleType(i) {
  const el = document.getElementById('type-' + i);
  const isOpen = el.classList.contains('active');
  document.querySelectorAll('.type-item').forEach(t => t.classList.remove('active'));
  if (!isOpen) el.classList.add('active');
}

buildTypes();
</script>
{% endraw %}{% endblock %}
