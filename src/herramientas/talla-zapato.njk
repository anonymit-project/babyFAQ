{% extends "layouts/herramienta.njk" %}

{% block jsonld %}{% raw %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Calculadora talla de zapato bebé por cm de pie",
  "description": "Introduce la longitud del pie de tu bebé en centímetros y obtén la talla de zapato en los sistemas europeo, americano y británico. Para bebés y niños de 0 a 6 años.",
  "url": "https://babyfaq.es/talla-zapato.html",
  "applicationCategory": "HealthApplication",
  "inLanguage": "es",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
  "publisher": { "@type": "Organization", "name": "babyFAQ", "url": "https://babyfaq.es" }
}
</script>
{% endraw %}{% endblock %}

{% block css %}{% raw %}
  .tip { display: flex; gap: 12px; align-items: flex-start; background: var(--cream); border-radius: 12px; padding: 12px 14px; margin-bottom: 20px; border: 1px solid rgba(196,168,152,0.2); }
  .tip-icon { font-size: 20px; flex-shrink: 0; margin-top: 1px; }
  .tip-text { font-size: 12px; color: var(--mid); line-height: 1.6; text-align: justify; }
  .tip-text strong { color: var(--deep); font-weight: 500; }

  .cm-selector { display: flex; align-items: center; justify-content: center; background: var(--cream); border-radius: 16px; border: 1.5px solid rgba(196,168,152,0.35); padding: 6px 8px; height: 72px; }
  .hold-btn { width: 48px; height: 52px; flex-shrink: 0; border-radius: 12px; border: none; background: transparent; color: var(--terracota); font-size: 26px; font-weight: 300; cursor: pointer; display: flex; align-items: center; justify-content: center; touch-action: manipulation; user-select: none; -webkit-user-select: none; transition: background 0.1s; line-height: 1; }
  .hold-btn:active, .hold-btn.pressing { background: var(--blush); }
  .cm-display { flex: 1; text-align: center; }
  .cm-value { font-family: 'Fraunces', serif; font-size: 48px; font-weight: 300; color: var(--deep); line-height: 1; display: block; }
  .cm-unit { font-size: 14px; color: var(--soft); }

  .result-card { display: none; background: var(--warm-white); border-radius: 20px; padding: 24px 20px; margin-bottom: 16px; box-shadow: 0 2px 20px rgba(61,43,31,0.06); border: 1px solid rgba(196,168,152,0.2); animation: fadeUp 0.35s ease; }
  .result-card.visible { display: block; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .result-age { text-align: center; margin-bottom: 20px; }
  .result-age-label { font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--soft); display: block; margin-bottom: 4px; }
  .result-age-value { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 400; color: var(--mid); font-style: italic; }

  .sizes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .size-block { background: var(--cream); border-radius: 14px; padding: 14px 16px; text-align: center; border: 1.5px solid transparent; }
  .size-block.primary { background: #edf5f0; border-color: #b2d9be; grid-column: 1 / -1; display: flex; align-items: center; justify-content: center; gap: 16px; padding: 16px 20px; }
  .size-system { font-size: 10px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--soft); margin-bottom: 4px; display: block; }
  .size-value { font-family: 'Fraunces', serif; font-size: 36px; font-weight: 400; color: var(--deep); line-height: 1; display: block; }
  .size-block.primary .size-value { font-size: 48px; color: var(--sage); }
  .size-block.primary .size-system { color: var(--sage); }
  .size-note { font-size: 11px; color: var(--soft); text-align: center; margin-top: 14px; line-height: 1.5; }

  .table-toggle { width: 100%; background: transparent; border: 1.5px solid rgba(196,168,152,0.4); border-radius: 14px; padding: 12px; font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--mid); cursor: pointer; margin-top: 14px; transition: border-color 0.2s, color 0.2s; }
  .table-toggle:hover { border-color: var(--terracota); color: var(--terracota); }
  .full-table { display: none; margin-top: 14px; }
  .full-table.visible { display: block; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  thead th { font-size: 10px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--soft); padding: 6px 8px; text-align: center; border-bottom: 1px solid rgba(196,168,152,0.3); }
  tbody tr { transition: background 0.15s; }
  tbody tr:hover { background: rgba(242,196,176,0.15); }
  tbody tr.highlight { background: #edf5f0; font-weight: 500; }
  tbody td { padding: 7px 8px; text-align: center; color: var(--deep); font-family: 'Fraunces', serif; font-size: 14px; border-bottom: 1px solid rgba(196,168,152,0.12); }
  tbody td:first-child { font-family: 'DM Sans', sans-serif; font-size: 12px; color: var(--mid); font-weight: 500; }
  tbody tr.highlight td { color: var(--sage); }
  tbody tr.highlight td:first-child { color: var(--mid); }

  .seo-table-wrap { overflow-x: auto; margin: 16px 0 24px; }
  .seo-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .seo-table thead th { font-size: 10px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--soft); padding: 8px 10px; text-align: left; border-bottom: 1px solid rgba(196,168,152,0.3); background: var(--warm-white); }
  .seo-table tbody td { padding: 8px 10px; font-size: 13px; color: var(--mid); border-bottom: 1px solid rgba(196,168,152,0.12); vertical-align: top; }
  .seo-table tbody td:first-child { font-weight: 500; color: var(--deep); white-space: nowrap; }
  .seo-table tbody tr:last-child td { border-bottom: none; }

  @media (min-width: 640px) {
    .page-grid {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 28px;
      align-items: start;
    }
    .right-col { position: sticky; top: 28px; }
    .right-col .result-card { margin-bottom: 0; }
  }
{% endraw %}{% endblock %}

{% block contenido %}
  <header>
    <span class="badge">Ropa y tallas</span>
    <h1>¿Qué talla de <em>zapato</em> le pongo?</h1>
    <p class="subtitle">Introduce la longitud del pie y obtén la talla en todos los sistemas al instante.</p>
  </header>

  <div class="page-grid">
  <div class="left-col">

  <div class="card">
    <div class="section-label">Longitud del pie</div>
    <div class="tip">
      <span class="tip-icon">📏</span>
      <p class="tip-text"><strong>Cómo medir:</strong> pon al bebé de pie sobre un folio, marca el talón y el dedo más largo, mide la distancia entre las dos marcas. Añade 5&nbsp;mm para holgura.</p>
    </div>
    <div class="cm-selector">
      <button class="hold-btn" id="btn-minus" data-dir="-1" aria-label="Reducir longitud del pie">−</button>
      <div class="cm-display">
        <span class="cm-value" id="cm-value">12.0</span>
        <span class="cm-unit">cm</span>
      </div>
      <button class="hold-btn" id="btn-plus" data-dir="1" aria-label="Aumentar longitud del pie">+</button>
    </div>
  </div>

  </div><!-- /left-col -->
  <div class="right-col">

  <div class="result-card visible" id="result-card">
    <div class="section-label">Tallas recomendadas</div>
    <div class="result-age">
      <span class="result-age-label">Edad aproximada</span>
      <span class="result-age-value" id="result-age">—</span>
    </div>
    <div class="sizes-grid">
      <div class="size-block primary">
        <div>
          <span class="size-system">EU · FR</span>
          <span class="size-value" id="sz-eu">—</span>
        </div>
      </div>
      <div class="size-block"><span class="size-system">US</span><span class="size-value" id="sz-us">—</span></div>
      <div class="size-block"><span class="size-system">UK</span><span class="size-value" id="sz-uk">—</span></div>
    </div>
    <p class="size-note" id="size-note"></p>
    <button class="table-toggle" id="table-toggle" onclick="toggleTable()" aria-label="Mostrar u ocultar tabla completa de tallas">Ver tabla completa ↓</button>
    <div class="full-table" id="full-table">
      <table id="size-table">
        <thead><tr><th>cm pie</th><th>EU · FR</th><th>US</th><th>UK</th><th>Edad aprox.</th></tr></thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>
  </div>

  </div><!-- /right-col -->
  </div><!-- /page-grid -->

  <p class="disclaimer">Las tallas varían según fabricante. Úsalas como referencia y comprueba siempre antes de comprar. Los rangos de edad son orientativos — cada bebé crece a su ritmo.</p>

  <!-- Secciones informativas -->
  <div class="seo-section">
    <h2>Cómo elegir el zapato correcto para tu bebé</h2>
    <p>
      El calzado infantil es uno de los aspectos más importantes para el desarrollo
      correcto del pie. Un zapato mal elegido — demasiado pequeño, demasiado rígido
      o de puntera estrecha — puede interferir con el desarrollo natural de los huesos
      y músculos del pie durante los primeros años de vida, cuando el pie es
      especialmente moldeable.
    </p>
    <p>
      La regla más importante es siempre <strong>medir el pie antes de comprar</strong>,
      no guiarse por la edad ni por la talla del último zapato. Los pies de los bebés
      crecen muy rápido — hasta la talla 24 pueden cambiar de número cada 2–3 meses.
      Además, el pie izquierdo y el derecho pueden tener longitudes ligeramente diferentes:
      compra siempre para el pie más largo.
    </p>

    <h2>Tabla de tallas de zapato bebé por cm de pie</h2>
    <div class="seo-table-wrap">
      <table class="seo-table">
        <thead><tr><th>cm pie</th><th>EU / FR</th><th>US</th><th>UK</th><th>Edad aprox.</th></tr></thead>
        <tbody>
          <tr><td>9,0 – 9,5 cm</td><td>15 – 16</td><td>1 – 1½</td><td>0 – ½</td><td>0 – 3 meses</td></tr>
          <tr><td>10,0 – 10,5 cm</td><td>17</td><td>2 – 2½</td><td>1 – 1½</td><td>3 – 6 meses</td></tr>
          <tr><td>11,0 – 11,5 cm</td><td>18 – 19</td><td>3 – 3½</td><td>2 – 3</td><td>6 – 9 meses</td></tr>
          <tr><td>12,0 – 12,5 cm</td><td>20</td><td>4 – 4½</td><td>3½ – 4</td><td>9 – 12 meses</td></tr>
          <tr><td>13,0 – 13,5 cm</td><td>21 – 22</td><td>5 – 5½</td><td>4½ – 5</td><td>12 – 18 meses</td></tr>
          <tr><td>14,0 – 14,5 cm</td><td>23</td><td>6½ – 7</td><td>6</td><td>18 – 24 meses</td></tr>
          <tr><td>15,0 – 15,5 cm</td><td>24</td><td>7½ – 8</td><td>7</td><td>2 años</td></tr>
          <tr><td>16,0 – 17,0 cm</td><td>25 – 27</td><td>8½ – 9½</td><td>7½ – 9</td><td>2 – 3 años</td></tr>
          <tr><td>17,5 – 19,0 cm</td><td>28 – 30</td><td>10½ – 12</td><td>10 – 11½</td><td>3 – 4 años</td></tr>
          <tr><td>19,5 – 22,0 cm</td><td>31 – 34</td><td>12½ – 2</td><td>12 – 1½</td><td>4 – 6 años</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Preguntas frecuentes sobre los zapatos de bebé</h2>
{% for item in faq %}
    <div class="faq-item">
      <h3>{{ item.q }}</h3>
      <p>{{ item.a | safe }}</p>
    </div>
{% endfor %}

    <!-- Fuentes consultadas -->
    <div class="sources">
      <p class="sources-title">📚 Fuentes consultadas</p>
      <ul>
        <li>📌 <a href="https://www.aeped.es" target="_blank" rel="noopener">Asociación Española de Pediatría (AEP)</a> — recomendaciones sobre desarrollo del pie en la infancia</li>
        <li>📌 <a href="https://www.healthychildren.org" target="_blank" rel="noopener">American Academy of Pediatrics (AAP)</a> — guías sobre calzado infantil y primeros pasos</li>
        <li>📌 <a href="https://www.mscbs.gob.es" target="_blank" rel="noopener">Ministerio de Sanidad de España</a> — orientaciones sobre salud infantil y desarrollo motor</li>
      </ul>
    </div>

    <p class="disclaimer" style="margin-top:20px;">Última revisión: {{ ultimaRevision | fechaLarga }}</p>

    <p class="disclaimer" style="margin-top:20px;">
      Esta herramienta es orientativa. Las tallas varían entre fabricantes. Ante cualquier duda sobre el desarrollo del pie de tu bebé, consulta con su pediatra o un podólogo infantil.
    </p>
  </div>
{% endblock %}

{% block script %}{% raw %}
<script>
const SIZE_TABLE=[
  {cm:9.0,eu:15,us:'1',uk:'0',age:'0 – 3 meses'},
  {cm:9.5,eu:16,us:'1½',uk:'½',age:'0 – 3 meses'},
  {cm:10.0,eu:17,us:'2',uk:'1',age:'3 – 6 meses'},
  {cm:10.5,eu:17,us:'2½',uk:'1½',age:'3 – 6 meses'},
  {cm:11.0,eu:18,us:'3',uk:'2',age:'6 – 9 meses'},
  {cm:11.5,eu:19,us:'3½',uk:'3',age:'6 – 9 meses'},
  {cm:12.0,eu:20,us:'4',uk:'3½',age:'9 – 12 meses'},
  {cm:12.5,eu:20,us:'4½',uk:'4',age:'9 – 12 meses'},
  {cm:13.0,eu:21,us:'5',uk:'4½',age:'12 – 18 meses'},
  {cm:13.5,eu:22,us:'5½',uk:'5',age:'12 – 18 meses'},
  {cm:14.0,eu:23,us:'6½',uk:'6',age:'18 – 24 meses'},
  {cm:14.5,eu:23,us:'7',uk:'6',age:'18 – 24 meses'},
  {cm:15.0,eu:24,us:'7½',uk:'7',age:'2 años'},
  {cm:15.5,eu:24,us:'8',uk:'7',age:'2 años'},
  {cm:16.0,eu:25,us:'8½',uk:'7½',age:'2 – 3 años'},
  {cm:16.5,eu:26,us:'9',uk:'8',age:'2 – 3 años'},
  {cm:17.0,eu:27,us:'9½',uk:'9',age:'3 años'},
  {cm:17.5,eu:28,us:'10½',uk:'10',age:'3 – 4 años'},
  {cm:18.0,eu:29,us:'11',uk:'10½',age:'3 – 4 años'},
  {cm:18.5,eu:29,us:'11½',uk:'11',age:'4 años'},
  {cm:19.0,eu:30,us:'12',uk:'11½',age:'4 – 5 años'},
  {cm:19.5,eu:31,us:'12½',uk:'12',age:'4 – 5 años'},
  {cm:20.0,eu:32,us:'13',uk:'12½',age:'5 años'},
  {cm:20.5,eu:32,us:'13½',uk:'13',age:'5 años'},
  {cm:21.0,eu:33,us:'1',uk:'1',age:'5 – 6 años'},
  {cm:21.5,eu:33,us:'1½',uk:'1',age:'5 – 6 años'},
  {cm:22.0,eu:34,us:'2',uk:'1½',age:'6 años'},
];
const CM_VALUES=SIZE_TABLE.map(r=>r.cm);
let currentIdx=CM_VALUES.indexOf(12.0);

function makeHoldBtn(el,onStep){
  let h=null,r=null,s=0;
  function fire(){onStep(parseInt(el.dataset.dir));}
  function start(){fire();s=1;h=setTimeout(()=>{r=setInterval(()=>{fire();s++;if(s===10){clearInterval(r);r=setInterval(fire,60);}},150);},350);}
  function stop(){clearTimeout(h);clearInterval(r);h=r=null;s=0;el.classList.remove('pressing');}
  el.addEventListener('touchstart',e=>{e.preventDefault();el.classList.add('pressing');start();},{passive:false});
  el.addEventListener('touchend',stop,{passive:true});
  el.addEventListener('touchcancel',stop,{passive:true});
  el.addEventListener('mousedown',()=>{el.classList.add('pressing');start();});
  el.addEventListener('mouseup',stop);
  el.addEventListener('mouseleave',stop);
}

makeHoldBtn(document.getElementById('btn-minus'),dir=>updateCm(dir));
makeHoldBtn(document.getElementById('btn-plus'),dir=>updateCm(dir));

function updateCm(dir){
  currentIdx=Math.max(0,Math.min(CM_VALUES.length-1,currentIdx+dir));
  render();
}

function render(){
  const row=SIZE_TABLE[currentIdx];
  document.getElementById('cm-value').textContent=row.cm.toFixed(1);
  document.getElementById('sz-eu').textContent=row.eu;
  document.getElementById('sz-us').textContent=row.us;
  document.getElementById('sz-uk').textContent=row.uk;
  document.getElementById('result-age').textContent=row.age;
  let note='';
  if(currentIdx===0)note='⬆️ Este es el mínimo de la tabla';
  if(currentIdx===CM_VALUES.length-1)note='Este es el máximo de la tabla (a partir de aquí usa tallas de niño)';
  document.getElementById('size-note').textContent=note;
  document.querySelectorAll('#table-body tr').forEach((tr,i)=>{
    tr.classList.toggle('highlight',i===currentIdx);
  });
  const highlighted=document.querySelector('#table-body tr.highlight');
  if(highlighted&&document.getElementById('full-table').classList.contains('visible')){
    highlighted.scrollIntoView({block:'nearest',behavior:'smooth'});
  }
}

function buildTable(){
  const tbody=document.getElementById('table-body');
  SIZE_TABLE.forEach((row,i)=>{
    const tr=document.createElement('tr');
    if(i===currentIdx)tr.classList.add('highlight');
    tr.innerHTML=`<td>${row.cm.toFixed(1)} cm</td><td>${row.eu}</td><td>${row.us}</td><td>${row.uk}</td><td>${row.age}</td>`;
    tr.addEventListener('click',()=>{currentIdx=i;render();});
    tbody.appendChild(tr);
  });
}

function toggleTable(){
  const table=document.getElementById('full-table');
  const btn=document.getElementById('table-toggle');
  const open=table.classList.toggle('visible');
  btn.textContent=open?'Ocultar tabla ↑':'Ver tabla completa ↓';
  if(open){
    const highlighted=document.querySelector('#table-body tr.highlight');
    if(highlighted)setTimeout(()=>highlighted.scrollIntoView({block:'nearest',behavior:'smooth'}),50);
  }
}

buildTable();
render();
</script>
{% endraw %}{% endblock %}
