// ── State ──────────────────────────────────────────────────────────
const STORAGE_KEY = 'babyfaq_bolsa_v1';
let checked = {};
let activeFilter = 'all';

const ALL_ITEMS = SECTIONS.flatMap(s => s.items.map(i => ({ ...i, sectionId: s.id, who: s.who })));

function loadState() {
  try {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored) checked = JSON.parse(stored);
  } catch(e) { checked = {}; }
  ALL_ITEMS.forEach(i => { if (checked[i.id] === undefined) checked[i.id] = false; });
}

function saveState() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(checked)); } catch(e) {}
}

function resetAll() {
  ALL_ITEMS.forEach(i => { checked[i.id] = false; });
  saveState();
  buildUI();
  updateProgress();
}

// ── Filter tabs ────────────────────────────────────────────────────
const FILTERS = [
  { id: 'all',         label: 'Todo',         icon: '📋' },
  { id: 'docs',        label: 'Documentos',   icon: '📄' },
  { id: 'mama',        label: 'Mamá',         icon: '🤱' },
  { id: 'bebe',        label: 'Bebé',         icon: '👶' },
  { id: 'acompanante', label: 'Acompañante',  icon: '🧑' },
  { id: 'vuelta-casa', label: 'Casa',         icon: '🏠' },
];

function buildFilterTabs() {
  const wrap = document.getElementById('filter-tabs');
  wrap.innerHTML = '';
  FILTERS.forEach(f => {
    const btn = document.createElement('button');
    btn.className = 'filter-tab' + (f.id === activeFilter ? ' active' : '');
    btn.setAttribute('aria-label', `Filtrar checklist: ${f.label}`);

    let count;
    if (f.id === 'all') {
      count = ALL_ITEMS.length;
    } else if (f.id === 'mama') {
      count = ALL_ITEMS.filter(i => i.sectionId === 'mama-parto' || i.sectionId === 'mama-postparto').length;
    } else {
      count = SECTIONS.find(s => s.id === f.id)?.items.length || 0;
    }

    btn.innerHTML = `${f.icon} ${f.label} <span class="tab-count">${count}</span>`;
    btn.addEventListener('click', () => {
      activeFilter = f.id;
      buildFilterTabs();
      buildSections();
    });
    wrap.appendChild(btn);
  });
}

// ── Build sections ─────────────────────────────────────────────────
function buildSections() {
  const wrap = document.getElementById('sections-wrap');
  wrap.innerHTML = '';

  const visibleSections = SECTIONS.filter(s => {
    if (activeFilter === 'all') return true;
    if (activeFilter === 'mama') return s.id === 'mama-parto' || s.id === 'mama-postparto';
    if (activeFilter === 'vuelta-casa') return s.id === 'vuelta-casa';
    return s.id === activeFilter;
  });

  visibleSections.forEach(section => {
    const doneInSection = section.items.filter(i => checked[i.id]).length;
    const total = section.items.length;

    const block = document.createElement('div');
    block.className = 'section-block';
    block.id = 'section-' + section.id;

    const header = document.createElement('div');
    header.className = 'section-header';
    header.setAttribute('role', 'button');
    header.setAttribute('aria-label', `${section.title} — ${doneInSection} de ${total} completados`);
    header.style.color = section.color;
    header.innerHTML = `
      <span class="section-icon">${section.icon}</span>
      <span class="section-title">${section.title}</span>
      <span class="section-prog">${doneInSection}/${total}</span>
      <span class="section-chevron">›</span>`;
    header.addEventListener('click', () => {
      block.classList.toggle('collapsed');
    });

    const itemsWrap = document.createElement('div');
    itemsWrap.className = 'section-items';

    section.items.forEach(item => {
      const div = document.createElement('div');
      div.className = `check-item${item.tags.includes('optional') ? ' optional' : ''}${checked[item.id] ? ' done' : ''}`;
      div.id = 'ci-' + item.id;
      div.setAttribute('role', 'checkbox');
      div.setAttribute('aria-checked', checked[item.id] ? 'true' : 'false');
      div.setAttribute('aria-label', item.name);
      div.innerHTML = `
        <div class="check-box"><span class="check-tick">✓</span></div>
        <div class="check-body">
          <div class="check-name">${item.name}</div>
          ${item.sub ? `<div class="check-sub">${item.sub}</div>` : ''}
          <div class="check-tags">
            ${item.tags.includes('important') ? '<span class="check-tag tag-important">⭐ Esencial</span>' : ''}
            ${item.tags.includes('optional')  ? '<span class="check-tag tag-optional">Opcional</span>'   : ''}
          </div>
        </div>`;

      const toggle = () => {
        checked[item.id] = !checked[item.id];
        div.classList.toggle('done', checked[item.id]);
        div.setAttribute('aria-checked', checked[item.id] ? 'true' : 'false');
        saveState();
        updateProgress();
        const newDone = section.items.filter(i => checked[i.id]).length;
        header.querySelector('.section-prog').textContent = `${newDone}/${total}`;
      };

      div.addEventListener('click', toggle);

      itemsWrap.appendChild(div);
    });

    block.appendChild(header);
    block.appendChild(itemsWrap);
    wrap.appendChild(block);
  });
}

// ── Update progress ────────────────────────────────────────────────
function updateProgress() {
  const total = ALL_ITEMS.length;
  const done  = ALL_ITEMS.filter(i => checked[i.id]).length;
  const pct   = total > 0 ? Math.round((done / total) * 100) : 0;

  document.getElementById('done-count').textContent   = done;
  document.getElementById('left-count').textContent   = total - done;
  document.getElementById('pct-display').textContent  = pct + '%';
  document.getElementById('progress-fill').style.width = pct + '%';

  const allDone = document.getElementById('all-done');
  allDone.classList.toggle('visible', pct === 100);
}

function buildUI() {
  buildFilterTabs();
  buildSections();
}

loadState();
buildUI();
updateProgress();
</script>
