  STAGES.forEach(s => {
    const btn = document.createElement('button');
    btn.className = 'age-pill' + (s.id === selectedStage ? ' active' : '');
    btn.textContent = s.label;
    btn.setAttribute('aria-label', `Ver juguetes para la etapa ${s.label}`);
    btn.setAttribute('aria-pressed', s.id === selectedStage ? 'true' : 'false');
    btn.addEventListener('click', () => {
      selectedStage = s.id;
      document.querySelectorAll('.age-pill').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      renderStage();
    });
    wrap.appendChild(btn);
  });
}

// ── Render stage ───────────────────────────────────────────────────
function renderStage() {
  const stage = STAGES.find(s => s.id === selectedStage);
  if (!stage) return;

  document.getElementById('sh-emoji').textContent = stage.emoji;
  document.getElementById('sh-label').textContent = stage.label;
  document.getElementById('sh-title').textContent = stage.title;
  document.getElementById('sh-desc').textContent  = stage.desc;

  const devTagsWrap = document.getElementById('dev-tags');
  devTagsWrap.innerHTML = '';
  stage.devAreas.forEach(area => {
    const m = DEV_META[area];
    if (!m) return;
    const span = document.createElement('span');
    span.className = `dev-tag ${m.cls}`;
    span.textContent = m.label;
    devTagsWrap.appendChild(span);
  });

  // Toys
  const toysWrap = document.getElementById('toys-wrap');
  toysWrap.innerHTML = '';
  stage.toys.forEach((toy, idx) => {
    const card = document.createElement('div');
    card.className = 'toy-card';

    const cats = toy.cats.map(c => {
      const m = CAT_META[c];
      return m ? `<span class="toy-cat ${m.cls}">${m.label}</span>` : '';
    }).join('');

    card.innerHTML = `
      <div class="toy-top" role="button" aria-expanded="false" aria-label="Ver detalles de ${toy.name}" tabindex="0">
        <div class="toy-icon" aria-hidden="true">${toy.icon}</div>
        <div class="toy-main">
          <div class="toy-name">${toy.name}</div>
          <div class="toy-cats">${cats}</div>
        </div>
        ${toy.essential ? '<span class="toy-essential">⭐ Esencial</span>' : ''}
        <span class="toy-chevron" aria-hidden="true">›</span>
      </div>
      <div class="toy-detail">
        <div class="toy-why">${toy.why}</div>
        <span class="toy-how-label">💡 Cómo aprovecharlo al máximo</span>
        <div class="toy-how-list">${toy.how.map(h => `<div class="toy-how-item">${h}</div>`).join('')}</div>
        ${toy.safety ? `<div class="toy-safety">${toy.safety}</div>` : ''}
      </div>`;

    const top = card.querySelector('.toy-top');
    const toggle = () => {
      const open = card.classList.toggle('open');
      top.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    top.addEventListener('click', toggle);
    top.addEventListener('keydown', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggle(); } });
    toysWrap.appendChild(card);
  });

  // Avoid
  const avoidList = document.getElementById('avoid-list');
  avoidList.innerHTML = '';
  stage.avoid.forEach(a => {
    const div = document.createElement('div');
    div.className = 'avoid-item';
    div.innerHTML = `
      <span class="avoid-icon" aria-hidden="true">${a.icon}</span>
      <div class="avoid-body">
        <div class="avoid-name">${a.name}</div>
        <div class="avoid-desc">${a.desc}</div>
      </div>`;
    avoidList.appendChild(div);
  });
}

// ── Init ──────────────────────────────────────────────────────────
buildPills();
renderStage();
</script>
