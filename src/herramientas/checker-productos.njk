{% extends "layouts/herramienta.njk" %}

{% block jsonld %}{% raw %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Checker de productos de bebé — ¿Lo necesito realmente?",
