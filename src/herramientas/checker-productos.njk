let activeFilter='all';
let searchQuery='';

function buildPills(){
  const wrap=document.getElementById('filter-pills');
  FILTERS.forEach(f=>{
    const btn=document.createElement('button');
    btn.className='filter-pill'+(f.id===activeFilter?' active-'+f.id:'');
    btn.textContent=f.label;
    btn.setAttribute('aria-label', `Filtrar por: ${f.label}`);
    btn.addEventListener('click',()=>{
      activeFilter=f.id;
      document.querySelectorAll('.filter-pill').forEach(b=>{b.className='filter-pill';});
      btn.className='filter-pill active-'+f.id;
      applyFilters();
    });
    wrap.appendChild(btn);
  });
}

function applyFilters(){
  searchQuery=document.getElementById('search').value.toLowerCase().trim();
  const cats={};
  PRODUCTS.forEach(p=>{if(!cats[p.cat])cats[p.cat]=[];cats[p.cat].push(p);});
  const output=document.getElementById('product-output');
  output.innerHTML='';
  let totalVisible=0;

  Object.entries(cats).forEach(([catName,products])=>{
    const matching=products.filter(p=>{
      if(activeFilter!=='all'&&p.verdict!==activeFilter)return false;
      if(searchQuery){
        const nm=p.name.toLowerCase().includes(searchQuery);
        const tg=p.tags.some(t=>t.includes(searchQuery));
        if(!nm&&!tg)return false;
      }
      return true;
    });
    if(matching.length===0)return;
    matching.sort((a,b)=>{
      const d=VERDICT_ORDER[a.verdict]-VERDICT_ORDER[b.verdict];
      if(d!==0)return d;
      return a.name.localeCompare(b.name,'es');
    });
    totalVisible+=matching.length;

    const section=document.createElement('div');
    section.className='category-section';

    const header=document.createElement('div');
    header.className='cat-header open';
    header.setAttribute('role','button');
    header.setAttribute('aria-label',`Categoría ${catName} — ${matching.length} productos`);
    header.innerHTML=`<span class="cat-icon">${getCatIcon(catName)}</span><span class="cat-name">${catName}</span><span class="cat-count">${matching.length}</span><span class="cat-chevron">›</span>`;

    const list=document.createElement('div');
    list.className='product-list open';
    list.innerHTML=matching.map(p=>{
      const v=VERDICT[p.verdict];
      return`<div class="product-card ${p.verdict}"><span class="product-icon">${p.icon}</span><div class="product-body"><div class="product-name">${p.name}</div><div class="product-verdict">${v.label}</div><div class="product-note">${p.note}</div></div><span class="verdict-icon">${v.icon}</span></div>`;
    }).join('');

    header.addEventListener('click',()=>{
      const open=list.classList.toggle('open');
      header.classList.toggle('open',open);
    });
    section.appendChild(header);
    section.appendChild(list);
    output.appendChild(section);
  });

  if(totalVisible===0){
    output.innerHTML=`<div class="no-results"><span class="no-results-icon">🤔</span>No hemos encontrado "${searchQuery}".<br>Prueba con otro nombre.</div>`;
  }
  document.getElementById('results-meta').textContent=totalVisible>0
    ?`${totalVisible} producto${totalVisible!==1?'s':''}${activeFilter!=='all'?' · '+FILTERS.find(f=>f.id===activeFilter)?.label:''}`
    :'';
}

function getCatIcon(cat){
  const map={'Dormir':'🌙','Alimentación':'🍼','Baño e higiene':'🛁','Movilidad y transporte':'🚗','Juego y estimulación':'🧸','Ropa y accesorios':'👕','Salud y seguridad':'🛡️'};
  return map[cat]||'📦';
}

buildPills();
applyFilters();
</script>
